%% Фигура 1 — осемте етапа, с означено разделяне преди напасване.
%% Рендира се с: mmdc -i fig-01-pipeline.mmd -o fig-01-pipeline.pdf
flowchart TD
    F[["суров файл<br/>CSV / XLSX"]] --> L

    subgraph STRUCT["нищо не се учи от данните"]
        direction TB
        L["1. Четене<br/>кодировка, разделител, заглавен ред"]
        P["2. Профилиране<br/>какъв е типът на всяка колона"]
        D["3. Откриване<br/>22 проверки → находки с предложения"]
        V["4. Валидиране<br/>спрямо декларирани правила"]
        PL["5. План<br/>подредени поправки, вкл. изведени"]
        C1["6а. Структурни поправки<br/>дубликати, прикрити липсващи, мъртви колони"]
        L --> P --> D --> V --> PL --> C1
    end

    C1 ==> SPLIT{{"РАЗДЕЛЯНЕ<br/>стратифицирано, преди всяко напасване"}}

    SPLIT -->|обучаваща част| T1
    SPLIT -->|задържана част| H1

    subgraph FIT["научено САМО от обучаващата част"]
        direction TB
        T1["6б. Запълване, ограничаване на аномалии"]
        T2["7. Признаци<br/>логаритмуване, дати, кодиране, мащабиране"]
        T1 --> T2
    end

    T2 -.->|"същите стойности, приложени"| H1["задържани редове<br/>никога не се напасва върху тях"]

    T2 --> E["8. Доказателство<br/>един модел, две обработки"]
    H1 --> E
    E --> R[["почистени данни + отчет"]]

    classDef split fill:#B0413E,stroke:#7A2C2A,color:#fff,font-weight:bold
    classDef io fill:#1F4E79,stroke:#14375A,color:#fff
    class SPLIT split
    class F,R io
